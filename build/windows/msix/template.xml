<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="harflex"
        Arguments=""
        InstallLocation="C:\Program Files\Harflex">
    </Installer>
    <PackageInformation
        PackageName="Harflex"
        PackageDisplayName="Harflex"
        PublisherName="CN=persio.flexa"
        PublisherDisplayName="persio.flexa"
        Version="0.2.1.0"
        PackageDescription="Local-first agentic development harness">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="ai.harflex.desktop"
                Description="Local-first agentic development harness"
                DisplayName="Harflex"
                ExecutableName="harflex"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Harflex</DisplayName>
            <PublisherDisplayName>persio.flexa</PublisherDisplayName>
            <Description>Local-first agentic development harness</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="harflex.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
